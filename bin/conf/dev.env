# 开发环境配置（提交到 git，不含生产密钥）
#
# WORK_PATH / LOG_DIR / INDEX_PATH / DICT_PATH 未设置时由 switch-env.sh 按仓库根推导；
# 这里只写需要覆盖的项。

LOG_LEVEL=debug

# RPC Hub 监听端口（InkStackServer 的 rpc.hub_address 要指向这里）
RPC_PORT=9010
RELAY_TIMEOUT_MS=3000

IO_THREADS=1
ACCEPT_THREADS=1

REBUILD_ON_START=true
SAVE_INTERVAL_MS=30000
REBUILD_TIMEOUT_MS=600000
MAX_PAGE_SIZE=100

INSTANCE_ID=1
PID_FILE=search.pid
