# 生产环境配置模板（复制为 prod.env 后填写真实值；prod.env 已被 .gitignore 忽略）
#
# 搜索服务是单实例 Hub：所有 InkStackServer 实例通过 RPC_HUB_ADDRESS 指向这里。

# 程序/配置目录（部署包解压位置）
WORK_PATH=/opt/inkstack-search
# 日志目录
LOG_DIR=/data/apps/inkstack-search/logs
# 索引文件（父目录需可写，建议放在持久化盘）
INDEX_PATH=/opt/inkstack-search/indices/search.index
# cppjieba 词典目录（随包提供在 <部署目录>/dict）
DICT_PATH=/opt/inkstack-search/dict
# 其他数据目录，可留空
DATA_PATH=

PID_FILE=search.pid
INSTANCE_ID=1

LOG_LEVEL=info

# RPC Hub 监听端口；InkStackServer 的 rpc.hub_address / search.hub_address 指向它
RPC_PORT=9010
RELAY_TIMEOUT_MS=3000

IO_THREADS=1
ACCEPT_THREADS=1

# 启动时丢弃索引并等待 InkStackServer 全量快照重建
REBUILD_ON_START=true
SAVE_INTERVAL_MS=30000
REBUILD_TIMEOUT_MS=600000
MAX_PAGE_SIZE=100
